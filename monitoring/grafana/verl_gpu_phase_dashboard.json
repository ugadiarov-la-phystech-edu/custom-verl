  "panels": [
    {
      "type": "state-timeline",
      "title": "Per-GPU phase (one lane per GPU x role)",
      "description": "What each GPU is doing right now and over time. Lanes are (node, gpu, role): in colocated runs the same GPU has a rollout lane (gen/sleep, emitted by the vLLM server) and a trainer lane (logprob/update/weight-sync, emitted by the worker). idle = waiting for work / data.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "datasource": null,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 72,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#8a8a8a", "value": null }] },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "idle", "color": "#8a8a8a", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "gen", "color": "#3987e5", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "logprob_fwd", "color": "#199e70", "index": 2 } } },
            { "type": "value", "options": { "3": { "text": "ref_fwd", "color": "#9085e9", "index": 3 } } },
            { "type": "value", "options": { "4": { "text": "values_fwd", "color": "#d55181", "index": 4 } } },
            { "type": "value", "options": { "5": { "text": "update_actor", "color": "#c98500", "index": 5 } } },
            { "type": "value", "options": { "6": { "text": "update_critic", "color": "#008300", "index": 6 } } },
            { "type": "value", "options": { "7": { "text": "weight_sync", "color": "#d95926", "index": 7 } } },
            { "type": "value", "options": { "8": { "text": "sleep", "color": "#55565a", "index": 8 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
